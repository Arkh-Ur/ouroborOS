#!/usr/bin/env bash
# ouroboros-firstboot — first-boot setup for ouroborOS
#
# Runs ONCE on the first boot of the installed system (guarded by firstboot.done).
# Performs tasks that require a live system with network access and can't be
# done safely during installation (reflector needs internet, machine-id needs
# the real hardware, btrfs-scrub needs the mounted filesystem).
#
# Guard file: /var/lib/ouroborOS/firstboot.done
# The systemd unit uses ConditionPathExists=! on this file to skip re-runs.
set -euo pipefail

readonly GUARD_DIR="/var/lib/ouroborOS"
readonly GUARD_FILE="${GUARD_DIR}/firstboot.done"
readonly LOG_TAG="ouroboros-firstboot"

_log()  { echo "[${LOG_TAG}] $*"; }
_warn() { echo "[${LOG_TAG}] WARNING: $*" >&2; }
_err()  { echo "[${LOG_TAG}] ERROR: $*" >&2; }

_usage() {
    cat <<'EOF'
ouroboros-firstboot — first-boot setup for ouroborOS

Runs ONCE on the first boot of the installed system (guarded by firstboot.done).
Optimises the pacman mirrorlist, ensures a unique machine-id, enables system
maintenance timers, and processes any queued AUR installs.

Usage: ouroboros-firstboot

This tool takes no options; it is invoked automatically by its systemd unit.
EOF
}

case "${1:-}" in
    -h|--help|help)
        _usage
        exit 0
        ;;
esac

# Idempotency guard (belt + suspenders — unit also checks via Condition)
if [[ -f "$GUARD_FILE" ]]; then
    _log "Already ran (${GUARD_FILE} exists). Nothing to do."
    exit 0
fi

# Write guard first so a mid-run crash doesn't trigger an infinite re-run loop
# on every subsequent boot. Sections below use || _warn to handle failures gracefully.
mkdir -p "$GUARD_DIR"
date -Iseconds > "$GUARD_FILE"

_log "Starting first-boot setup..."

# ── 1. Optimise pacman mirror list ───────────────────────────────────────────
_log "Updating mirrorlist with reflector (sort score, HTTPS, latest 20)..."
if command -v reflector &>/dev/null; then
    reflector \
        --save /etc/pacman.d/mirrorlist \
        --sort score \
        --latest 20 \
        --protocol https \
        --verbose 2>/dev/null || \
        _warn "reflector failed — existing mirrorlist kept."
    _log "Mirrorlist updated."
else
    _warn "reflector not installed — skipping mirror update."
fi

# ── 2. Ensure machine-id is unique ───────────────────────────────────────────
# If this machine booted from an ISO or was cloned, the machine-id may be
# a well-known placeholder.  Regenerate to guarantee uniqueness.
_log "Verifying machine-id uniqueness..."
current_id=$(cat /etc/machine-id 2>/dev/null || echo "")
# Known ISO placeholder IDs (add more as needed)
PLACEHOLDER_IDS=(
    "b08dfa6083e7567a1921a715000001fb"
    "00000000000000000000000000000000"
)
needs_regen=false
for placeholder in "${PLACEHOLDER_IDS[@]}"; do
    if [[ "$current_id" == "$placeholder" ]]; then
        needs_regen=true
        break
    fi
done

if [[ "$needs_regen" == true ]]; then
    _log "Placeholder machine-id detected (${current_id}) — regenerating..."
    systemd-machine-id-setup --commit 2>/dev/null || \
        _warn "Could not regenerate machine-id."
    _log "machine-id regenerated: $(cat /etc/machine-id)"
else
    _log "machine-id looks unique: ${current_id}"
fi

# ── 3. Enable and start system timers ────────────────────────────────────────
_log "Enabling system maintenance timers..."

# our-snapshot-prune.timer — daily Btrfs snapshot rotation
# (also enabled at install time; this is a safety net for upgrades)
if systemctl enable --now our-snapshot-prune.timer 2>/dev/null; then
    _log "our-snapshot-prune.timer enabled and started."
else
    _warn "our-snapshot-prune.timer not available — skipping."
fi

# btrfs-scrub@-.timer — weekly Btrfs integrity check on root (/)
# The unit is provided by the btrfs-progs package (Arch ships it).
# The instance `-` is the systemd path-escape for `/`.
if systemctl enable --now "btrfs-scrub@-.timer" 2>/dev/null; then
    _log "btrfs-scrub@-.timer enabled and started (weekly scrub of /)."
else
    _warn "btrfs-scrub@-.timer not available (btrfs-progs installed?). Skipping."
fi

# systemd-sysext — merge AUR sysext extensions installed by our-aur
# Extensions live in /var/lib/extensions/our-aur-*/
# Enable systemd-sysext (may fail to start if no extensions exist yet)
systemctl enable systemd-sysext 2>/dev/null || true
# Start systemd-sysext explicitly (skip trigger conditions)
systemctl start systemd-sysext 2>/dev/null || true
if systemctl is-active systemd-sysext >/dev/null 2>&1; then
    _log "systemd-sysext enabled and started (AUR extensions merged)."
else
    _warn "systemd-sysext not available — our-aur extensions won't auto-merge on boot."
fi

# ── 3.5. Enable Hyprland user services (polkit agent + XDG portal) ─────────
# The Hyprland desktop profile installs hyprpolkitagent and
# xdg-desktop-portal-hyprland, but those are USER services. Without an
# explicit `systemctl --user enable`, the Hyprland "Getting started" wizard
# reports "Authentication agent: Missing" and "XDG Desktop Portal: Missing".
# Enable + start both for every real (UID >= 1000) user with a live session.
_log "Enabling Hyprland user services (polkit agent + XDG portal)..."

# Iterate over users via getent passwd
while IFS=: read -r username _ uid _ _ _ _; do
    # Only real users with a running user slice (live login session)
    [[ "${uid}" =~ ^[0-9]+$ ]] || continue
    [[ "${uid}" -ge 1000 ]] || continue
    [[ -d "/run/user/${uid}" ]] || continue
    home_dir="$(getent passwd "${username}" | cut -d: -f6)"
    [[ -d "${home_dir}" ]] || continue
    [[ "${home_dir}" == /var/* || "${home_dir}" == /srv/* ]] && continue

    for svc in hyprpolkitagent xdg-desktop-portal-hyprland; do
        if XDG_RUNTIME_DIR="/run/user/${uid}" sudo -u "${username}" XDG_RUNTIME_DIR="/run/user/${uid}" systemctl --user enable --now "${svc}" 2>/dev/null; then
            _log "  ${username}: ${svc} enabled + started."
        else
            _warn "${username}: could not enable ${svc} (no lingering session?)."
        fi
    done
done < <(getent passwd)

# ── 3.6. Generate per-user Hyprland config with installer choices ─────────
# F5: the installer captures the user's preferred terminal + filemanager
# (see DesktopConfig.apply_profile_defaults) and writes them to
# /var/lib/ouroborOS/desktop-prefs.json. Firstboot reads that and generates
# ~/.config/hypr/hyprland.conf with the correct $terminal and $fileManager
# variables, so the hyprland-config-wizard doesn't override them with the
# foot/dolphin AUR defaults.
PREFS_FILE="/var/lib/ouroborOS/desktop-prefs.json"
if [[ -f "${PREFS_FILE}" ]] && command -v jq &>/dev/null; then
    pref_term="$(jq -r '.terminal // "foot"' "${PREFS_FILE}")"
    pref_fm="$(jq -r '.filemanager // "thunar"' "${PREFS_FILE}")"
    _log "Hyprland defaults: terminal=${pref_term}, filemanager=${pref_fm}"

    while IFS=: read -r username _ uid _ _ _ _; do
        [[ "${uid}" =~ ^[0-9]+$ ]] || continue
        [[ "${uid}" -ge 1000 ]] || continue
        [[ -d "/run/user/${uid}" ]] || continue
        home_dir="$(getent passwd "${username}" | cut -d: -f6)"
        [[ -d "${home_dir}" ]] || continue
        [[ "${home_dir}" == /var/* || "${home_dir}" == /srv/* ]] && continue

        conf_dir="${home_dir}/.config/hypr"
        conf_file="${conf_dir}/hyprland.conf"
        # Don't clobber an existing user-customised conf
        if [[ -f "${conf_file}" ]]; then
            _log "  ${username}: ${conf_file} exists — leaving untouched."
            continue
        fi
        mkdir -p "${conf_dir}"
        cat > "${conf_file}" <<EOF
# Generated by ouroboros-firstboot on $(date -Iseconds)
# This file overrides the hyprland-config-wizard defaults.
# Edit freely — it will not be regenerated.

\$terminal = ${pref_term}
\$fileManager = ${pref_fm}

# Source the rest of the hyprland ecosystem defaults
source = ~/.config/hypr/hyprland-defaults.conf
EOF
        chown -R "${username}:$(id -gn "${username}")" "${conf_dir}" 2>/dev/null || true
        _log "  ${username}: wrote ${conf_file} with terminal=${pref_term}, filemanager=${pref_fm}"
    done < <(getent passwd)
else
    _log "Hyprland prefs file not present (${PREFS_FILE}) — skipping firstboot config gen."
fi

# ── 4. Install AUR packages queued by the installer ──────────────────────────
readonly AUR_QUEUE_FILE="/var/lib/ouroborOS/firstboot-aur-packages.txt"
if [[ -f "${AUR_QUEUE_FILE}" ]]; then
    _log "AUR packages queued for install: $(cat "${AUR_QUEUE_FILE}")"
    if command -v our-aur &>/dev/null; then
        while IFS= read -r aur_pkg; do
            [[ -z "${aur_pkg}" ]] && continue
            _log "Installing AUR package: ${aur_pkg}"
            our-aur -S "${aur_pkg}" 2>&1 || \
                _warn "Failed to install AUR package '${aur_pkg}' — try: sudo our-aur -S ${aur_pkg}"
        done <<< "$(tr ' ' '\n' < "${AUR_QUEUE_FILE}")"
        _log "AUR packages install complete."
    else
        _warn "our-aur not found — AUR packages not installed. Install manually: sudo our-aur -S <pkg>"
    fi
    rm -f "${AUR_QUEUE_FILE}"
fi

# ── 5. Mark as done ──────────────────────────────────────────────────────────
_log "First-boot setup complete. Guard: ${GUARD_FILE}"
