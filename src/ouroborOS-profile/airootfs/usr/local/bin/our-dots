#!/usr/bin/env bash
# our-dots — Dotfiles/config pack manager for ouroborOS
# Installs and manages curated ricing packs on top of installed desktop profiles.
# Usage: our-dots <command> [options]
set -euo pipefail

readonly MANIFEST_DIR="/usr/local/lib/ouroboros/dots/packs"
readonly REPOS_DIR="/var/lib/ouroboros/dots/repos"
readonly REPOS_INDEX="/etc/ouroboros/dots-repos.yaml"
readonly SYSYAML="/etc/ouroboros/system.yaml"
readonly LOG_DIR="/var/log/our-dots"
readonly VERSION="0.6.1"

RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
BOLD='\033[1m'
RESET='\033[0m'

# ── Helpers ────────────────────────────────────────────────────────────────────

log_info()  { echo -e "${GREEN}[our-dots]${RESET} $*"; }
log_warn()  { echo -e "${YELLOW}[our-dots] WARNING:${RESET} $*" >&2; }
log_error() { echo -e "${RED}[our-dots] ERROR:${RESET} $*" >&2; }

die() { log_error "$*"; exit 1; }

require_root() {
    [[ "${EUID:-$(id -u)}" -eq 0 ]] || die "This operation requires root. Run with sudo."
}

# Parse a scalar value from a YAML manifest using Python safe_load.
yaml_get() {
    local file="$1" key="$2"
    python3 -c "
import yaml, sys
with open('${file}') as f:
    d = yaml.safe_load(f) or {}
keys = '${key}'.split('.')
val = d
for k in keys:
    if isinstance(val, dict):
        val = val.get(k)
    else:
        val = None
        break
if val is None:
    sys.exit(1)
print(str(val).strip())
" 2>/dev/null
}

# Parse a YAML list into newline-separated items.
yaml_list() {
    local file="$1" key="$2"
    python3 -c "
import yaml
with open('${file}') as f:
    d = yaml.safe_load(f) or {}
keys = '${key}'.split('.')
val = d
for k in keys:
    if isinstance(val, dict):
        val = val.get(k) or []
    else:
        val = []
        break
for item in (val or []):
    print(item)
" 2>/dev/null
}

# Update system.yaml dots_packs key (atomic write).
sysyaml_add_pack() {
    local id="$1" channel="$2" version="$3"
    require_root
    python3 - <<EOF
import yaml, os, datetime
path = "${SYSYAML}"
with open(path) as f:
    doc = yaml.safe_load(f) or {}
packs = doc.setdefault("dots_packs", [])
packs = [p for p in packs if p.get("id") != "${id}"]
packs.append({
    "id": "${id}",
    "channel": "${channel}",
    "installed_version": "${version}",
    "installed_at": datetime.date.today().isoformat(),
})
doc["dots_packs"] = packs
tmp = path + ".tmp"
with open(tmp, "w") as f:
    yaml.dump(doc, f, default_flow_style=False, allow_unicode=True)
os.replace(tmp, path)
EOF
}

sysyaml_remove_pack() {
    local id="$1"
    require_root
    python3 - <<EOF
import yaml, os
path = "${SYSYAML}"
with open(path) as f:
    doc = yaml.safe_load(f) or {}
packs = doc.get("dots_packs", [])
doc["dots_packs"] = [p for p in packs if p.get("id") != "${id}"]
tmp = path + ".tmp"
with open(tmp, "w") as f:
    yaml.dump(doc, f, default_flow_style=False, allow_unicode=True)
os.replace(tmp, path)
EOF
}

sysyaml_is_installed() {
    local id="$1"
    python3 -c "
import yaml
with open('${SYSYAML}') as f:
    doc = yaml.safe_load(f) or {}
packs = doc.get('dots_packs', [])
ids = [p.get('id') for p in packs]
exit(0 if '${id}' in ids else 1)
" 2>/dev/null
}

sysyaml_installed_info() {
    local id="$1"
    python3 -c "
import yaml
with open('${SYSYAML}') as f:
    doc = yaml.safe_load(f) or {}
for p in doc.get('dots_packs', []):
    if p.get('id') == '${id}':
        print(p.get('installed_version','?') + '  ' + p.get('installed_at','?'))
        exit(0)
exit(1)
" 2>/dev/null
}

# Find a manifest file by pack id (built-in first, then external repos).
find_manifest() {
    local id="$1"
    local f="${MANIFEST_DIR}/${id}.yaml"
    [[ -f "$f" ]] && { echo "$f"; return 0; }
    # Search external repos
    if [[ -d "$REPOS_DIR" ]]; then
        local repo_manifest
        repo_manifest=$(find "$REPOS_DIR" -name "${id}.yaml" 2>/dev/null | head -1)
        [[ -n "$repo_manifest" ]] && { echo "$repo_manifest"; return 0; }
    fi
    return 1
}

compat_badge() {
    case "$1" in
        low)      echo -e "${GREEN}low${RESET}" ;;
        medium)   echo -e "${YELLOW}medium${RESET}" ;;
        high)     echo -e "${YELLOW}⚠ high${RESET}" ;;
        critical) echo -e "${RED}⚠ CRITICAL${RESET}" ;;
        *)        echo "$1" ;;
    esac
}

# ── Commands ───────────────────────────────────────────────────────────────────

cmd_list() {
    printf "%-22s %-14s %-10s %-12s %s\n" "NAME" "DE" "COMPAT" "CHANNEL" "INSTALLED"
    printf "%s\n" "------------------------------------------------------------------------------"

    local manifests=()
    while IFS= read -r -d '' f; do manifests+=("$f"); done \
        < <(find "$MANIFEST_DIR" -name "*.yaml" -print0 2>/dev/null | sort -z)
    if [[ -d "$REPOS_DIR" ]]; then
        while IFS= read -r -d '' f; do manifests+=("$f"); done \
            < <(find "$REPOS_DIR" -name "*.yaml" -print0 2>/dev/null | sort -z)
    fi

    for mf in "${manifests[@]:-}"; do
        [[ -z "$mf" ]] && continue
        local id name profiles compat channel installed
        id=$(yaml_get "$mf" "id" 2>/dev/null) || continue
        name=$(yaml_get "$mf" "name" 2>/dev/null) || name="$id"
        profiles=$(yaml_list "$mf" "compatibility.profiles" 2>/dev/null | tr '\n' ',' | sed 's/,$//')
        compat=$(yaml_get "$mf" "compatibility.immutable" 2>/dev/null) || compat="?"
        # Determine default channel display
        if python3 -c "import yaml; d=yaml.safe_load(open('$mf')); exit(0 if d.get('variants',{}).get('git') else 1)" 2>/dev/null; then
            channel="stable/git"
        else
            channel=$(yaml_get "$mf" "variants.stable.version_hint" 2>/dev/null) || channel="stable"
        fi
        if sysyaml_is_installed "$id" 2>/dev/null; then
            installed=$(sysyaml_installed_info "$id" 2>/dev/null | awk '{print $1}')
        else
            installed="-"
        fi
        printf "%-22s %-14s %-10s %-12s %s\n" "$name" "${profiles:-?}" "$compat" "$channel" "$installed"
    done
}

cmd_info() {
    local id="$1"
    local mf
    mf=$(find_manifest "$id") || die "Pack not found: $id"

    local name description author homepage docs compat note hint_s hint_g
    name=$(yaml_get "$mf" "name")
    description=$(python3 -c "
import yaml, textwrap
with open('$mf') as f:
    d = yaml.safe_load(f)
desc = (d.get('description') or '').strip()
for line in textwrap.wrap(desc, width=60):
    print('  ' + line)
")
    author=$(yaml_get "$mf" "credits.author" 2>/dev/null) || author="unknown"
    homepage=$(yaml_get "$mf" "credits.homepage" 2>/dev/null) || homepage="-"
    docs=$(yaml_get "$mf" "credits.docs" 2>/dev/null) || docs="-"
    compat=$(yaml_get "$mf" "compatibility.immutable" 2>/dev/null) || compat="?"
    note=$(yaml_get "$mf" "compatibility.compatibility_note" 2>/dev/null) || note=""
    hint_s=$(yaml_get "$mf" "variants.stable.version_hint" 2>/dev/null) || hint_s="-"
    hint_g=$(yaml_get "$mf" "variants.git.version_hint" 2>/dev/null) || true

    echo ""
    echo -e "${BOLD}Pack         :${RESET} $id"
    echo -e "${BOLD}Name         :${RESET} $name"
    echo -e "${BOLD}Description  :${RESET}"
    echo "$description"
    echo ""
    echo -e "${BOLD}Creator      :${RESET} $author"
    echo -e "${BOLD}Homepage     :${RESET} $homepage"
    [[ "$docs" != "-" ]] && echo -e "${BOLD}Docs         :${RESET} $docs"
    echo -e "${BOLD}Immutability :${RESET} $(compat_badge "$compat")"
    [[ -n "$note" ]] && echo -e "${BOLD}Note         :${RESET} $note"
    echo ""
    echo -e "${BOLD}Channels     :${RESET}"
    echo "  stable  — $hint_s"
    [[ -n "${hint_g:-}" ]] && echo "  git     — $hint_g"

    echo ""
    if sysyaml_is_installed "$id" 2>/dev/null; then
        local info
        info=$(sysyaml_installed_info "$id")
        echo -e "${BOLD}Installed    :${RESET} ${GREEN}yes${RESET}  ($info)"
    else
        echo -e "${BOLD}Installed    :${RESET} not installed"
    fi
    echo ""
}

cmd_install() {
    local id="" channel="stable" noconfirm=false
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --git)        channel="git" ;;
            --noconfirm)  noconfirm=true ;;
            -*)           die "Unknown option: $1" ;;
            *)            if [[ -z "$id" ]]; then id="$1"; else die "Unexpected argument: $1"; fi ;;
        esac
        shift
    done
    [[ -z "$id" ]] && die "Usage: our-dots -S <pack> [--git] [--noconfirm]"

    local mf
    mf=$(find_manifest "$id") || die "Pack not found: $id"

    local compat
    compat=$(yaml_get "$mf" "compatibility.immutable")

    # CRITICAL warning flow
    if [[ "$compat" == "critical" ]] && [[ "$noconfirm" == false ]]; then
        local warning
        warning=$(yaml_get "$mf" "compatibility.compatibility_warning" 2>/dev/null) || warning=""
        echo ""
        echo -e "${RED}${BOLD}╔══════════════════════════════════════════════════════════════╗${RESET}"
        echo -e "${RED}${BOLD}║  ⚠  CRITICAL COMPATIBILITY WARNING — ${id}${RESET}"
        echo -e "${RED}${BOLD}╠══════════════════════════════════════════════════════════════╣${RESET}"
        echo ""
        echo "$warning" | fold -s -w 62 | sed 's/^/  /'
        echo ""
        echo -e "  ${BOLD}Actions that will be taken on your system:${RESET}"
        local i=1
        while IFS= read -r action; do
            [[ -z "$action" ]] && continue
            echo "    $i. $action"
            ((i++))
        done < <(yaml_list "$mf" "critical_actions" 2>/dev/null)
        echo ""
        echo -e "${RED}${BOLD}╚══════════════════════════════════════════════════════════════╝${RESET}"
        echo ""
        printf "  Type 'yes' to proceed, anything else to cancel: "
        read -r answer
        [[ "${answer,,}" == "yes" ]] || { log_info "Cancelled."; exit 1; }
    elif [[ "$compat" == "high" ]] && [[ "$noconfirm" == false ]]; then
        local note
        note=$(yaml_get "$mf" "compatibility.compatibility_note" 2>/dev/null) || note=""
        echo ""
        echo -e "${YELLOW}${BOLD}⚠  HIGH compatibility impact: ${RESET}$note"
        printf "  Continue? [y/N] "
        read -r answer
        [[ "${answer,,}" == "y" ]] || { log_info "Cancelled."; exit 1; }
    fi

    # Credits panel
    cmd_info "$id"

    # Channel selection (interactive if both variants exist and not forced)
    if [[ "$noconfirm" == false ]] && \
       python3 -c "import yaml; d=yaml.safe_load(open('$mf')); exit(0 if d.get('variants',{}).get('git') else 1)" 2>/dev/null && \
       python3 -c "import yaml; d=yaml.safe_load(open('$mf')); exit(0 if d.get('variants',{}).get('stable') else 1)" 2>/dev/null && \
       [[ "$channel" == "stable" ]]; then
        local hint_s hint_g
        hint_s=$(yaml_get "$mf" "variants.stable.version_hint" 2>/dev/null) || hint_s="stable"
        hint_g=$(yaml_get "$mf" "variants.git.version_hint" 2>/dev/null) || hint_g="git"
        echo -e "${BOLD}  Channel:${RESET}"
        echo "    1  stable  — $hint_s  (recommended)"
        echo "    2  git     — $hint_g"
        printf "  Select [1-2, default 1]: "
        read -r ch_choice
        [[ "$ch_choice" == "2" ]] && channel="git"
    fi

    # Final confirm
    if [[ "$noconfirm" == false ]]; then
        printf "  Install? [y/N] "
        read -r confirm
        [[ "${confirm,,}" == "y" ]] || { log_info "Cancelled."; exit 1; }
    fi

    # Install
    mkdir -p "$LOG_DIR"
    local logfile
    logfile="${LOG_DIR}/${id}-$(date +%Y%m%d-%H%M%S).log"
    log_info "Installing $id (channel: $channel) — log: $logfile"

    local pkgs aur_pkgs
    mapfile -t pkgs   < <(yaml_list "$mf" "variants.${channel}.packages" 2>/dev/null)
    mapfile -t aur_pkgs < <(yaml_list "$mf" "variants.${channel}.aur" 2>/dev/null)

    if [[ ${#pkgs[@]} -gt 0 ]] && [[ -n "${pkgs[0]}" ]]; then
        log_info "Installing pacman packages: ${pkgs[*]}"
        our-pac -S "${pkgs[@]}" --noconfirm 2>&1 | tee -a "$logfile"
    fi

    if [[ ${#aur_pkgs[@]} -gt 0 ]] && [[ -n "${aur_pkgs[0]}" ]]; then
        log_info "Installing AUR packages: ${aur_pkgs[*]}"
        our-aur -S "${aur_pkgs[@]}" 2>&1 | tee -a "$logfile" || {
            log_error "AUR install failed. Check $logfile"
            exit 3
        }
    fi

    # post_deploy as calling user (not root)
    local post_deploy
    post_deploy=$(python3 -c "
import yaml
with open('$mf') as f:
    d = yaml.safe_load(f)
v = d.get('variants', {}).get('$channel', {})
script = v.get('post_deploy') or ''
print(script.strip())
" 2>/dev/null)
    if [[ -n "$post_deploy" ]]; then
        log_info "Running post-deploy script as ${SUDO_USER:-$USER}..."
        local run_user="${SUDO_USER:-$USER}"
        if [[ "$run_user" == "root" ]]; then
            bash -c "$post_deploy" 2>&1 | tee -a "$logfile" || {
                log_error "post_deploy failed. Check $logfile"
                exit 4
            }
        else
            sudo -u "$run_user" bash -c "$post_deploy" 2>&1 | tee -a "$logfile" || {
                log_error "post_deploy failed. Check $logfile"
                exit 4
            }
        fi
    fi

    local version_hint
    version_hint=$(yaml_get "$mf" "variants.${channel}.version_hint" 2>/dev/null) || version_hint="$channel"
    sysyaml_add_pack "$id" "$channel" "$version_hint"
    log_info "${GREEN}${BOLD}$id installed successfully.${RESET}"
}

cmd_remove() {
    local id="$1"
    [[ -z "$id" ]] && die "Usage: our-dots -R <pack>"

    sysyaml_is_installed "$id" 2>/dev/null || die "Pack not installed: $id"

    local mf
    mf=$(find_manifest "$id") || die "Manifest not found for $id — remove entry from system.yaml manually"

    printf "  Remove %s? [y/N] " "$id"
    read -r confirm
    [[ "${confirm,,}" == "y" ]] || { log_info "Cancelled."; exit 1; }

    local pkgs aur_pkgs
    mapfile -t pkgs     < <(yaml_list "$mf" "uninstall.packages" 2>/dev/null)
    mapfile -t aur_pkgs < <(yaml_list "$mf" "uninstall.aur" 2>/dev/null)

    if [[ ${#aur_pkgs[@]} -gt 0 ]] && [[ -n "${aur_pkgs[0]}" ]]; then
        log_info "Removing AUR packages: ${aur_pkgs[*]}"
        our-aur -R "${aur_pkgs[@]}" --noconfirm 2>/dev/null || log_warn "Some AUR packages could not be removed"
    fi
    if [[ ${#pkgs[@]} -gt 0 ]] && [[ -n "${pkgs[0]}" ]]; then
        log_info "Removing pacman packages: ${pkgs[*]}"
        our-pac -R "${pkgs[@]}" --noconfirm 2>/dev/null || log_warn "Some packages could not be removed"
    fi

    local post_remove
    post_remove=$(python3 -c "
import yaml
with open('$mf') as f:
    d = yaml.safe_load(f)
print((d.get('uninstall',{}).get('post_remove') or '').strip())
" 2>/dev/null)
    if [[ -n "$post_remove" ]]; then
        local run_user="${SUDO_USER:-$USER}"
        [[ "$run_user" == "root" ]] \
            && bash -c "$post_remove" 2>/dev/null || true \
            || sudo -u "$run_user" bash -c "$post_remove" 2>/dev/null || true
    fi

    sysyaml_remove_pack "$id"
    log_info "$id removed."
}

cmd_query() {
    python3 -c "
import yaml
with open('${SYSYAML}') as f:
    doc = yaml.safe_load(f) or {}
packs = doc.get('dots_packs', [])
if not packs:
    print('  (no packs installed)')
else:
    for p in packs:
        print(f\"  {p.get('id','?'):<22} {p.get('channel','?'):<10} installed {p.get('installed_at','?')}\")
" 2>/dev/null
}

cmd_search() {
    local pattern="${1:-}"
    [[ -z "$pattern" ]] && { cmd_list; return; }
    cmd_list | grep -i "$pattern" || true
}

cmd_upgrade() {
    log_info "Checking installed packs for updates..."
    local updated=0 checked=0

    python3 -c "
import yaml
with open('${SYSYAML}') as f:
    doc = yaml.safe_load(f) or {}
for p in doc.get('dots_packs', []):
    print(p.get('id','') + ' ' + p.get('channel','stable'))
" 2>/dev/null | while read -r id channel; do
        [[ -z "$id" ]] && continue
        ((checked++)) || true
        local mf
        mf=$(find_manifest "$id" 2>/dev/null) || { log_warn "$id: manifest not found, skipping"; continue; }

        # AUR-based update check
        local aur_pkg
        aur_pkg=$(yaml_list "$mf" "variants.${channel}.aur" 2>/dev/null | head -1)
        if [[ -n "$aur_pkg" ]]; then
            local current_ver available_ver
            current_ver=$(pacman -Q "$aur_pkg" 2>/dev/null | awk '{print $2}') || { log_info "$id [$aur_pkg]: not installed via pacman"; continue; }
            available_ver=$(curl -sf "https://aur.archlinux.org/rpc/?v=5&type=info&arg=${aur_pkg}" \
                | python3 -c "import json,sys; d=json.load(sys.stdin); r=d.get('results',[]); print(r[0]['Version'] if r else '')" 2>/dev/null) || true
            if [[ -n "$available_ver" ]] && [[ "$available_ver" != "$current_ver" ]]; then
                log_info "$id: update available ($current_ver → $available_ver)"
                cmd_install "$id" "--${channel}" --noconfirm
                ((updated++)) || true
            else
                echo "  $id: up to date ($current_ver)"
            fi
        else
            echo "  $id: update check not available for this pack — use 'our-dots -S $id' to reinstall"
        fi
    done

    log_info "Done. $updated pack(s) updated."
}

# ── Repository management ──────────────────────────────────────────────────────

cmd_repo_add() {
    local name="$1" url="$2"
    [[ -z "$name" || -z "$url" ]] && die "Usage: our-dots repo-add <name> <url>"
    [[ "$url" == https://* ]] || die "Repository URL must use HTTPS"
    require_root

    local dest="${REPOS_DIR}/${name}"
    mkdir -p "$dest"

    if [[ "$url" == *.git ]] || git ls-remote "$url" HEAD &>/dev/null 2>&1; then
        log_info "Cloning manifest repository: $url"
        git clone --depth=1 "$url" "$dest" 2>&1 || die "Failed to clone $url"
    else
        log_info "Fetching manifest index from: $url"
        curl -sfL "${url%/}/index.yaml" -o "${dest}/index.yaml" \
            || die "Failed to fetch index.yaml from $url"
        # Fetch individual manifests listed in index
        python3 -c "
import yaml, urllib.request, os
with open('${dest}/index.yaml') as f:
    idx = yaml.safe_load(f) or {}
base = '${url}'.rstrip('/')
for pack_id in idx.get('packs', []):
    urllib.request.urlretrieve(base + '/' + pack_id + '.yaml', '${dest}/' + pack_id + '.yaml')
    print('  fetched', pack_id + '.yaml')
"
    fi

    # Register in index
    python3 - <<EOF
import yaml, os
path = "${REPOS_INDEX}"
doc = {}
if os.path.exists(path):
    with open(path) as f:
        doc = yaml.safe_load(f) or {}
repos = doc.setdefault("repos", [])
repos = [r for r in repos if r.get("name") != "${name}"]
repos.append({"name": "${name}", "url": "${url}"})
doc["repos"] = repos
tmp = path + ".tmp"
with open(tmp, "w") as f:
    yaml.dump(doc, f, default_flow_style=False, allow_unicode=True)
os.replace(tmp, path)
EOF
    log_info "Repository '$name' added."
}

cmd_repo_remove() {
    local name="$1"
    [[ -z "$name" ]] && die "Usage: our-dots repo-remove <name>"
    require_root

    rm -rf "${REPOS_DIR:?}/${name}"
    python3 - <<EOF
import yaml, os
path = "${REPOS_INDEX}"
if not os.path.exists(path):
    exit(0)
with open(path) as f:
    doc = yaml.safe_load(f) or {}
doc["repos"] = [r for r in doc.get("repos", []) if r.get("name") != "${name}"]
tmp = path + ".tmp"
with open(tmp, "w") as f:
    yaml.dump(doc, f, default_flow_style=False, allow_unicode=True)
os.replace(tmp, path)
EOF
    log_info "Repository '$name' removed."
}

cmd_repo_list() {
    printf "%-20s %-50s %s\n" "NAME" "URL" "PACKS"
    printf "%s\n" "--------------------------------------------------------------------------"
    local n
    n=$(find "$MANIFEST_DIR" -name "*.yaml" 2>/dev/null | wc -l)
    printf "%-20s %-50s %s\n" "built-in" "(shipped with ISO)" "$n"

    if [[ -f "$REPOS_INDEX" ]]; then
        python3 -c "
import yaml, os, glob
with open('${REPOS_INDEX}') as f:
    doc = yaml.safe_load(f) or {}
for r in doc.get('repos', []):
    name = r.get('name','?')
    url  = r.get('url','?')
    count = len(glob.glob('${REPOS_DIR}/' + name + '/*.yaml'))
    print(f'{name:<20} {url:<50} {count}')
" 2>/dev/null
    fi
}

cmd_repo_update() {
    require_root
    [[ ! -f "$REPOS_INDEX" ]] && { log_info "No external repositories configured."; return; }

    python3 -c "
import yaml
with open('${REPOS_INDEX}') as f:
    doc = yaml.safe_load(f) or {}
for r in doc.get('repos', []):
    print(r.get('name','') + ' ' + r.get('url',''))
" 2>/dev/null | while read -r name url; do
        [[ -z "$name" ]] && continue
        log_info "Updating repo: $name ($url)"
        local dest="${REPOS_DIR}/${name}"
        if [[ -d "${dest}/.git" ]]; then
            git -C "$dest" pull --ff-only 2>&1 || log_warn "Failed to update $name"
        else
            cmd_repo_add "$name" "$url" 2>/dev/null || log_warn "Failed to re-fetch $name"
        fi
    done
    log_info "Repository update complete."
}

# ── Usage ──────────────────────────────────────────────────────────────────────

usage() {
    cat <<EOF
our-dots v${VERSION} — Dotfiles/config pack manager for ouroborOS

Pack management:
  our-dots list              Show full pack catalog
  our-dots -Si <pack>        Show pack info and credits
  our-dots -S  <pack>        Install pack (stable channel)
  our-dots -S  <pack> --git  Install git/development channel
  our-dots -R  <pack>        Remove installed pack
  our-dots -Q                List installed packs
  our-dots -Qs <pattern>     Search catalog
  our-dots -Su               Update all installed packs

Repository management:
  our-dots repo-add    <name> <url>   Add external manifest repository
  our-dots repo-remove <name>         Remove external repository
  our-dots repo-list                  List all repositories
  our-dots repo-update                Fetch latest manifests from all repos

EOF
}

# ── Entry point ────────────────────────────────────────────────────────────────

[[ $# -eq 0 ]] && { usage; exit 0; }

case "$1" in
    list)              cmd_list ;;
    -Si)               shift; cmd_info "$@" ;;
    -S)                shift; cmd_install "$@" ;;
    -R)                shift; cmd_remove "$@" ;;
    -Q)                cmd_query ;;
    -Qs)               shift; cmd_search "$@" ;;
    -Su)               cmd_upgrade ;;
    repo-add)          shift; cmd_repo_add "$@" ;;
    repo-remove)       shift; cmd_repo_remove "$@" ;;
    repo-list)         cmd_repo_list ;;
    repo-update)       cmd_repo_update ;;
    --help|-h|help)    usage ;;
    --version)         echo "our-dots $VERSION" ;;
    *)                 die "Unknown command: $1. Run 'our-dots --help' for usage." ;;
esac
